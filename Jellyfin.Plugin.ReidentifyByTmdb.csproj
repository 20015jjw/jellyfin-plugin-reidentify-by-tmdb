<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Jellyfin.Plugin.ReidentifyByTmdb</RootNamespace>
    <!-- Set by release.sh: -p:PluginVersion=1.2.0.0. Jellyfin reads the plugin version from the assembly. -->
    <PluginVersion Condition="'$(PluginVersion)' == ''">0.0.0.1</PluginVersion>
    <AssemblyVersion>$(PluginVersion)</AssemblyVersion>
    <FileVersion>$(PluginVersion)</FileVersion>
    <Nullable>enable</Nullable>
    <!-- Override on the command line to match the server exactly, e.g. -p:JellyfinVersion=12.4.0 -->
    <JellyfinVersion>12.*</JellyfinVersion>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinVersion)">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <!-- For the settings page's API controller; provided by the server at runtime. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Configuration\configPage.html" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
